;---------------------------
; The main type
;---------------------------

define :validator [
    ; data
    params: #[]

    ; methods
    action: method [str, opts][
        panic "Validator should define its own action"
    ]

    test: method [][
        panic "Validator should include its own unit-tests"
    ]
]

;---------------------------
; The main module
;---------------------------

export module [
    ;---------------------------
    ; Private variables
    ;---------------------------

    validators: #[]

    ;---------------------------
    ; Initialization
    ;---------------------------

    init: method [][
        loop list ./"validators" 'validator [
            name: extract.filename validator
            do validator
            \validators\[name]: to to :type ~"|name|Validator" []!
        ]
    ]

    ;---------------------------
    ; Private methods
    ;---------------------------

    fetchParams: method [given :dictionary, usedParams :dictionary][
        res: #[]

        unless empty? usedParams ->
            loop usedParams [pname, pspec][
                switch key? given pname [
                    pval: given\[pname]

                    ; the expected type may be a single type
                    ; or a block of accepted types
                    ensure -> some? flatten @[pspec\0] 't -> is? t pval
                    res\[pname]: pval
                ][
                    res\[pname]: pspec\1
                ]
            ]

        return res
    ]

    ;---------------------------
    ; Public methods
    ;---------------------------

    _validators: method.public [][
        ; meant to be used 
        ; mainly by the unit-tests
        return sort \validators
    ]

    valid?: method.public [str :string :block][
        ;; description: « check if given string is valid
        ;; options: [
        ;;      base58: « check base-58 encoding
        ;;      card: « check credit card number
        ;;      date: « test if string contains valid date
        ;;      email: « verify e-mail address
        ;;      floating: « test if string contains a parsable floating-point value
        ;;      iban: « verify IBAN (International Bank Account Number)
        ;;      integer: « test if string contains a parsable integer value
        ;;      ip: « verify IP address
        ;;      isbn: « verify ISBN code
        ;;      json: « test if string contains valid JSON
        ;;      md5: « check if valid MD5 hash
        ;;      password: « check if given password is strong enough
        ;;      sedol: « verify SEDOL code
        ;;      semver: « verify version string (SemVer)
        ;;      sha: « verify SHA hash
        ;;      tld: « verify TLD (Top-Level Domain)
        ;;      url: « verify URL
        ;; ]
        ;; returns: :logical
        ;; example: {
        ;;      valid?.url "https://arturo-lang.io"
        ;;      ; => true
        ;;
        ;;      valid?.email "loremIpsum@
        ;;      ; => false
        ;;
        ;;      valid?.email ["my@email.com", "info@google.com"]
        ;;      ; => true
        ;; }

        ; grab (& consume) all given attributes right away:
        ; attributes are global and every built-in function
        ; pops the ones it recognizes - e.g. `#[]` (`dictionary`)
        ; would silently take our `.lower` - while leftovers
        ; would leak into the next call
        given: attrs

        inputs: (string? str)? -> @[str][
            ensure -> is? [:string] str
            str
        ]

        ; collect all requested validators
        ; (along with their options)
        requested: []
        loop \validators [name, validator][
            if key? given name [
                options: \fetchParams given validator\params
                requested: requested ++ @[validator, options]
            ]
        ]

        ; make sure we don't silently accept
        ; a missing (or misspelled) validator
        if empty? requested ->
            panic "no (valid) validator specified"

        loop requested [validator, options][
            loop inputs 'inp [
                unless do [ validator\action inp options ] ->
                    return false
            ]
        ]

        return true
    ]
]!
