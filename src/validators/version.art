;==========================================================
; Version validation
;
; based on SemVer 2.0.0:
; https://semver.org
;
; @file: src/validators/version.art
;==========================================================

define :versionValidator is :validator [

    ;------------------
    ; built-in data
    ;------------------

    ; For the regex, see:
    ; https://semver.org/#is-there-a-suggested-regular-expression-regex-to-check-a-semver-string

    isSemVer: {/^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-((?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\.(?:0|[1-9]\d*|\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\+([0-9a-zA-Z-]+(?:\.[0-9a-zA-Z-]+)*))?\z/}

    ;------------------
    ; methods
    ;------------------

    action: method [str, opts][
        ; we're not using `to :version` here,
        ; since it's way more lenient (e.g. `1.2.3.4`
        ; silently becomes `1.2.3`) and may even crash
        ; with sth like `1.2`
        match? str \isSemVer
    ]

    test: method [][
        #[
            valid: [
                "0.0.0"
                "1.2.3"
                "10.20.30"
                "1.2.3-beta"
                "1.2.3-beta.1"
                "1.0.0-alpha.0valid"
                "1.0.0-x-y-z.--"
                "1.2.3+build.5"
                "1.2.3-rc.1+build.5"
                "1.0.0+0.build.1-rc.10000aaa-kk-0.1"
            ]

            invalid: [
                ""
                "1"
                "1.2"
                "1.2.3.4"
                "01.2.3"
                "1.02.3"
                "1.2.03"
                "1.2.3-"
                "1.2.3-01"
                "1.2.3-beta..1"
                "1.2.3+"
                "1.2.3+build..5"
                "v1.2.3"
                " 1.2.3"
                "1.2.3 "
                "1.2.3\n"
                "a.b.c"
                "1..3"
            ]
        ]
    ]

]
