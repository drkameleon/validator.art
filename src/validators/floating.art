; Floating validation
;
; @file: src/validators/floating.art
;==========================================================


define :floatingValidator is :validator [

    ;------------------
    ; methods
    ;------------------

    action: function [str, opts][
        ; make sure there's at least one digit,
        ; since the converter would also happily
        ; accept things like `nan` or `inf`
        unless match? str {/[0-9]/} -> return false

        ; based on our own `to` converter
        ; and catching possible errors with `throws?`
        not? throws? [
            discard to :floating str
        ]
    ]

    test: method [][
        #[
            valid: [
                "12"
                "12.34"
                "12345.67890"
            ]

            invalid: [
                ""
                "three"
                "%$#@^#$"
                "nan"
                "NaN"
                "inf"
                "-inf"
            ]
        ]
    ]
    
]