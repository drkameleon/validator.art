;==========================================================
; ISBN validation
;
; @file: src/validators/isbn.art
;==========================================================

define :isbnValidator is :validator [
    
    ;------------------
    ; parameters
    ;------------------

    params: #[
        "10": @[:logical, false]
        "13": @[:logical, false]
    ]

    ;------------------
    ; helpers
    ;------------------

    isIsbn10?: function [isbn][
        ; see: https://en.wikipedia.org/wiki/ISBN#ISBN-10_check_digit_calculation
        if 10 <> size isbn -> return false
        [s, t]: 0
        loop 0..9 'i [
            t: t + isbn\[i]
            s: s + t
        ]
        return zero? s % 11
    ]

    isIsbn13?: function [isbn][
        ; see: https://rosettacode.org/wiki/ISBN13_check_digit#Arturo
        if 13 <> size isbn -> return false
        s: 0
        loop.with:'i isbn 'n [
            s: s + (even? i)? -> n -> 3*n
        ]
        return zero? s % 10
    ]

    ;------------------
    ; methods
    ;------------------

    action: method [str, opts][
        sanitized: []
        parts: split replace str {/[\s-]+/} ""

        ; for ISBN-10, the check digit
        ; may also be an X (standing for 10)
        if and? [10 = size parts][in? last parts ["X" "x"]] ->
            parts: (chop parts) ++ ["10"]

        if throws? [
            sanitized: to [:integer] parts
        ] -> return false

        if opts\["10"] -> return \isIsbn10? sanitized
        if opts\["13"] -> return \isIsbn13? sanitized

        return or? [\isIsbn13? sanitized][\isIsbn10? sanitized]
    ]

    test: method [][
        #[
            valid: [
                "0306406152"
                "0-306-40615-2"
                "9780596528126"
                "978-0596528126"
                "080442957X"
                "0-8044-2957-X"
                "080442957x"

                ["0306406152"       ["10": true]]
                ["080442957X"       ["10": true]]
                ["978-0596528126"   ["13": true]]
            ]

            invalid: [
                "askdjashd"
                "0306777152"
                "978-0596528199"
                "080442958X"
                "08044295X7"
                "978059652812X"

                ["0306406152"       ["13": true]]
                ["080442957X"       ["13": true]]
                ["978-0596528126"   ["10": true]]
            ]
        ]
    ]
    
]
