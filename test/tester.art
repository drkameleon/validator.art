import {unitt}!
import ./"../src/validator.art"!

suite "Test function calls" [
    test "single input" [
        assert -> valid?.email "drkameleon@gmail.com"
        assert -> valid?.url "https://arturo-lang.io"
        assert -> valid?.sedol "B15KXQ8"
        assert -> not? valid?.sedol "12345o6"
        assert -> not? valid?.email "drkameleon"
        assert -> not? valid?.url "google"
    ]

    test "multiple inputs" [
        assert -> valid?.email ["drkameleon@gmail.com", "yaniszaf@gmail.com"]
        assert -> valid?.url ["https://www.google.com", "https://arturo-lang.io"]
        assert -> not? valid?.email ["drkameleon", "yaniszaf"]
        assert -> not? valid?.email ["drkameleon@gmail.com", "yaniszaf"]
        assert -> not? valid?.url ["google", "arturolang"]
        assert -> not? valid?.url ["https://www.google.com", "arturolang"]
    ]

    test "with params" [
        assert -> valid?.date.format:"MM/dd/yyyy" "01/31/2024"
        assert -> valid?.date.format:'short "01/31/24"
        assert -> valid?.date.format:'long "January 31, 2024"
        assert -> not? valid?.date.format:'iso "31/01/24"
        assert -> valid?.password.min:4 "Ab1!"
        assert -> not? valid?.password "Ab1!"
        assert -> throws? [valid?.password.min:"4" "Ab1!"]
    ]

    test "no validator" [
        assert -> throws? [valid? "drkameleon@gmail.com"]
        assert -> throws? [valid?.emial "drkameleon@gmail.com"]
    ]

    test "no leftover attributes" [
        ; `url` fails first, but `.semver` & `.format`
        ; must not leak into the next calls
        assert -> not? valid?.semver.url "1.2.3"
        assert -> valid?.url "https://arturo-lang.io"
        assert -> not? valid?.url.date.format:'short "https://arturo-lang.io"
        assert -> valid?.date "2024-01-31"
    ]
]

loop _validators [name, validator][

    ; every test case goes through `valid?` - exactly
    ; as a user would call it - so that attribute handling,
    ; param type-checking, etc are tested as well
    ;
    ; e.g. `["01/31/24" [format: 'short]]` for `date`
    ; becomes: `valid?.date.format:pv\0 val`
    ; with `pv: @['short]` and `val: "01/31/24"`

    run: [
        val: new v
        pv: []
        attributes: ""
        if block? v [
            val: new v\0
            loop v\1 [nm,prm][
                attributes: attributes ++ ~".|to :string nm|:pv\\|size pv|"
                pv: pv ++ @[do @[prm]]
            ]
        ]
        call: ~"valid?.|name||attributes| val"
        ;print [call, val, pv]                          ; uncomment to DEBUG
        res: do call
        ;print ["result:" res]                          ; uncomment to DEBUG

        res
    ]
    
    suite color.bold #cyan capitalize name [
        tests: validator\test

        valids: @ tests\valid
        test ~{all |size valids| positive checks are valid} [
            assert ->
                every? valids 'v run
        ]
        invalids: @ tests\invalid
        test ~{all |size invalids| negative checks are invalid} [
            assert ->
                not? some? invalids 'v run
        ]
    ]
]

unitt\report 'full
